# AMME configuration. Copy to `.env`; every value below is the built-in
# default, so an empty `.env` is a valid, working configuration.

# ---------------------------------------------------------------- market --
# AVAXUSDT, not BTCUSDT -- chosen by measurement, via `make screen`.
#
# The screen ranks symbols by makeability = spread / (sigma * sqrt(holding)),
# i.e. the spread expressed in units of the volatility accrued while holding
# inventory. That is the quantity that decides whether a passive quoter has
# positive expectancy; spread in ticks or in bps both rank symbols wrongly.
#
#   AVAXUSDT  1.41  workable   <- this
#   ATOMUSDT  0.84  marginal
#   ETHUSDT   0.04  hostile
#   BTCUSDT   0.00  hostile    <- the previous default
#
# Every Binance spot symbol screened has a *binding tick* (spread pinned at
# exactly 1 tick), so the venue caps maker revenue everywhere; what separates
# them is how much volatility that one tick has to cover. On BTCUSDT one tick
# is 0.0015 bps against sigma of ~0.6 bps/sqrt(s) -- hopeless. On AVAXUSDT one
# tick is 1.52 bps with a ~1s queue, which is workable.
#
# Re-run `make screen` before trusting this: the ranking moves with market
# conditions, and AVAXUSDT is not permanently the right answer.
AMME_MARKET_SYMBOL=AVAXUSDT
AMME_MARKET_DEPTH_LEVELS=10
AMME_MARKET_DEPTH_UPDATE_MS=100
# Overridden at runtime by /api/v3/exchangeInfo -- see ingestion_svc.exchange.
AMME_MARKET_TICK_SIZE=0.001
AMME_MARKET_LOT_SIZE=0.01
# Signed bps. Binance VIP0 spot maker is +10bps, which exceeds the quoted
# spread on BTCUSDT by orders of magnitude; 0.0 models a rebate-neutral desk.
AMME_MARKET_MAKER_FEE_BPS=0.0

# ------------------------------------------------- Avellaneda-Stoikov -----
# LIVE values, for AVAXUSDT. These are NOT the backtest values.
#
# The harness's grid-searched gamma=1.5/kappa=3.0 are calibrated to the
# simulator's wider-spread regime. Applied to live BTCUSDT they produce a
# half-spread that pins to the 500-tick clamp ($5.00 against a $0.01 market
# spread) -- the engine stops participating entirely. That is the calibration
# transfer failure documented in docs/ARCHITECTURE.md s.6.5, observed live.
#
# These solve for a ~5-tick half-spread at BTCUSDT's measured volatility.
# Re-derive with `make calibrate` for any other symbol.
AMME_AS_GAMMA=0.02
AMME_AS_KAPPA=80.0
AMME_AS_HORIZON_MODE=infinite
AMME_AS_HORIZON_SECONDS=15.0
AMME_AS_MIN_HALF_SPREAD_TICKS=1.0
# Cap the quote at 50 ticks ($0.50). Beyond that we are not making a market.
AMME_AS_MAX_HALF_SPREAD_TICKS=50.0
# AVAX at ~$6.5 with a $5 min-notional: anything under ~0.77 AVAX is rejected
# by the venue. 1.0 AVAX (~$6.5) clears it with margin and is a round lot.
AMME_AS_QUOTE_SIZE=1.0
# 0.0 disables drift injection entirely (= the pure-A-S baseline).
# Grid-searched on the as_drift arm (artifacts/calibration_lambda.md). The
# mean-minus-dispersion criterion prefers 0.0; lambda=1.0 is chosen instead
# because it maximises Sharpe (365 vs 237) and mean P&L (+0.041 vs +0.012),
# and dispersion over 3 seeds is too noisy to pay a 1:1 penalty on. The
# 10-seed ablation confirms it: +353 Sharpe over pure A-S, winning 8/10.
AMME_AS_DRIFT_LAMBDA=1.0
AMME_AS_DRIFT_CONFIDENCE_FLOOR=0.40
AMME_AS_DRIFT_MAX_TICKS=20.0

# ------------------------------------------------------------- toxicity --
AMME_TOX_ENABLED=true
# A VPIN bucket must span enough trades to be a sample rather than a coin
# flip. Sized to AVAXUSDT flow; re-derive per symbol from `make screen`
# output (volume_per_second x ~15s).
AMME_TOX_VPIN_BUCKET_VOLUME=50.0
AMME_TOX_VPIN_BUCKETS=30
# The gate tracks this quantile of recent VPIN rather than a fixed level; a
# fixed 0.35 fired on 99.3% of updates in testing. See amme_core/toxicity.py.
AMME_TOX_VPIN_QUANTILE=0.90
AMME_TOX_VPIN_BETA=2.0
AMME_TOX_OFI_THRESHOLD=2.0
AMME_TOX_OFI_BETA=0.25
AMME_TOX_MAX_TOXICITY_MULTIPLIER=5.0

# ----------------------------------------------------------------- risk --
AMME_RISK_ENABLED=true
# ~50 AVAX (~$330) of inventory at risk, comparable exposure to the previous
# 0.05 BTC limit. Sized in base currency, so it must be re-set per symbol.
AMME_RISK_Q_MAX=50.0
AMME_RISK_Q_SOFT_FRAC=0.6
AMME_RISK_UNWIND_FRAC=0.95
AMME_RISK_MAX_POSITION_VALUE=10000.0
AMME_RISK_BREAKER_VOL_MULTIPLE=4.0
AMME_RISK_BREAKER_VPIN=0.80
AMME_RISK_BREAKER_DRAWDOWN=250.0
AMME_RISK_BREAKER_COOLDOWN_SECONDS=30.0

# ---------------------------------------------------------------- model --
# `stub` emits zero drift so the pipeline runs before any model exists.
# Switch to `torchscript` once `make train` has produced models/deeplob.ts.
AMME_MODEL_BACKEND=stub
# Must match the trained artifact. 50 is what `make train` exports, and what
# meets the 5ms p99 budget (T=100 measures 7.06ms). A mismatch here makes
# feature-svc emit a (100,40) tensor the model cannot accept.
AMME_MODEL_LOOKBACK=50
AMME_MODEL_LEVELS=10
AMME_MODEL_HORIZON_EVENTS=20
AMME_MODEL_LABEL_ALPHA=0.00002
AMME_MODEL_INFERENCE_P99_BUDGET_MS=5.0
AMME_MODEL_TORCH_THREADS=1

# ---------------------------------------------------------------- infra --
AMME_REDIS_URL=redis://localhost:6379/0
AMME_POSTGRES_DSN=postgresql://amme:amme@localhost:5432/amme
AMME_LOG_LEVEL=INFO
AMME_LOG_JSON=true
AMME_PERSIST_TICKS=true

# ------------------------------------------------------------- backtest --
AMME_BT_SEED=42
AMME_BT_DURATION_SECONDS=900
AMME_BT_WARMUP_SECONDS=90
AMME_BT_RESULTS_DIR=artifacts

# -------------------------------------------------------------- grafana --
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
